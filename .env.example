# FarmDrop Sauces - Backend Environment Configuration

# Server Port (Render sets this dynamically via $PORT)
PORT=5000

# Environment Mode (development | production)
NODE_ENV=development

# Allowed Frontend URL for CORS (Cloudflare Pages or custom domain)
# Example: https://farm-drop-sauces.pages.dev
# Set to '*' to allow all origins in development
FRONTEND_URL=https://farm-drop-sauces.pages.dev
